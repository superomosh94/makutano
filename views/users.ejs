<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Makutano Users</title>
  </head>
  <body>
    <h1>Makutano Users</h1>

    <h2>User List</h2>
    <ol>
      <% users.forEach(user => { %>
      <li>
        <h3><%= user.fullname %></h3>
        <p><%= user.email %></p>
      </li>
      <% }) %>
    </ol>

    <h2>Post List</h2>
    <ol>
      <% posts.forEach(post => { %>
      <li>
        <h3><%= post.title %></h3>
        <p><%= post.content %></p>
      </li>
      <% }) %>
    </ol>
  </body>
</html>
